{
  "name": "autoquest",
  "version": "2.0.0",
  "private": true,
  "description": "Automotive engineering education: 180 developed bilingual lessons, 10 module exams and E-City.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "python3 scripts/serve_preview.py --directory out",
    "prepare:data": "python3 scripts/prepare_data.py",
    "prebuild": "node scripts/prepare-build.mjs",
    "predev": "node scripts/prepare-build.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "@electric-sql/pglite": "0.5.11"
  }
}
